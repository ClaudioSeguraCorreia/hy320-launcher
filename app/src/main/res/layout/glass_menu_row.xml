<?xml version="1.0" encoding="utf-8"?>
<dev.hy320.launcher.glass.GlassTile xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginTop="5dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="5dp"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp"
    app:glassRadius="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rowLabel"
            style="@style/GlassText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/rowValue"
            style="@style/GlassText.Secondary"
            android:layout_marginStart="10dp"
            android:textSize="15sp" />
    </LinearLayout>
</dev.hy320.launcher.glass.GlassTile>
