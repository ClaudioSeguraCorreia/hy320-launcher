<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Launcher" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Texto sobre vidro: branco com sombra suave para ler em qualquer fundo -->
    <style name="GlassText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFF6F8FB</item>
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">4</item>
    </style>

    <style name="GlassText.Secondary">
        <item name="android:textColor">#D9FFFFFF</item>
    </style>
</resources>
